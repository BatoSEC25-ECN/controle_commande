	public : 
		void System_GV(float Boussole, float Girouette, float IMU_Gite)//fonction Gérant l'asservissement de la GV
		
		
		
		
Détermination de Angle_Opti_SV : 
	Orientation = (Cap_Actuel - Direction_VA)
	si Orientation > -180° & Orientation < 90°
		Angle_GV = (Abs(Direction_VA - 90))%180
	si Orientation > 0° & Orientation < 45 °
		Angle_GV = 90°
	si Orientation > 45° & Orientation < 90 °
		Angle_GV = 0°
		
		
Détermination de Angle_Opti_FV : 
	Orientation = (Cap_Actuel - Direction_VA)
	si Abs(Orientation) > 140°
		Angle_GV = (0°)//trop face au vent, on borde
	si Orientation > 0°
		Angle_GV = 0°
	si Orientation > 40° & Orientation < 90 °
		Angle_GV = (45/50)*(Direction_VA-90°) + 90°

	
		
		
		

//SE5
void pos_moteur(Angle_GV)
	: POS_MAX_Choq 1.32 
	  POS_MIN_Bord 1.8  
	  
	  temps_position_mooteur = Angle_GV / 90 * (1.8 - 1.32)
	  écrire pendant ce temps là sur la bonne broche un état haut de manière non bloquante 
	

			
